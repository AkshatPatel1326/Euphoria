# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/euphoria_db?schema=public"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Euphoria Administrator"
ADMIN_PASSWORD="your-strong-admin-password-min-12-chars"

# JWT Authentication Configuration
JWT_SECRET="your-strong-cryptographic-jwt-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Application Environment ("development" | "production")
NODE_ENV="development"

# Debug OTP (Security rule: only active when NODE_ENV="development" AND EXPOSE_DEBUG_OTP="true")
# Set to "false" in staging and production to ensure OTPs are never exposed in API responses
EXPOSE_DEBUG_OTP="true"

# ─────────────────────────────────────────────────────────────
# Email & OTP Delivery Configuration (Provider-Agnostic SMTP)
# ─────────────────────────────────────────────────────────────
# Set to "smtp" for real email dispatch, or "console" for mock terminal logging in dev
EMAIL_PROVIDER="console"

# Standard SMTP Server Host (e.g., smtp.gmail.com, smtp.mailgun.org, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=""

# SMTP Server Port (587 for STARTTLS, 465 for SSL/TLS, 25/2525)
SMTP_PORT="587"

# Set to "true" if using port 465 (SSL), or "false" for port 587 (STARTTLS)
SMTP_SECURE="false"

# SMTP Authentication Username / Email
SMTP_USER=""

# SMTP Authentication Password or App-Specific Password (never commit real passwords)
SMTP_PASS=""

# Sender Name & Address displayed to participants
# Example: "\"Euphoria 2026\" <noreply@yourdomain.com>"
EMAIL_FROM=""

# ─────────────────────────────────────────────────────────────
# Payment Gateway Configuration (Easebuzz Sandbox / Test Mode)
# ─────────────────────────────────────────────────────────────
# Options: "simulation" (dev mock) | "easebuzz" (Easebuzz gateway)
PAYMENT_GATEWAY="simulation"

# Easebuzz Environment: "test" for sandbox, "prod" for production
EASEBUZZ_ENV="test"

# Easebuzz Sandbox Credentials (placeholders; populate with credentials from Easebuzz test dashboard)
EASEBUZZ_KEY=""
EASEBUZZ_SALT=""

# Base Application URLs for Browser Redirects & Callbacks
APP_FRONTEND_URL="http://localhost:5173"
APP_BACKEND_URL="http://localhost:5000"

# CORS Origin (comma-separated list of allowed origins, e.g. "https://euphoria2026.sageuniversity.in")
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

